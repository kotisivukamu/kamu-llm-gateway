# Owner/privileged connection for the migration runner. Migrations create roles,
# ALTER ROLE, SECURITY DEFINER functions, so they run as the postgres owner --
# not app_user. This is the same URL as the api's BYPASSRLS_DATABASE_URL. The
# runner accepts either DATABASE_URL or BYPASSRLS_DATABASE_URL.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kamu-llm-gateway
