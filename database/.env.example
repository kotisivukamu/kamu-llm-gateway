# Owner/privileged connection for the migration runner. Migrations create
# app_user/admin_role by name only (no PASSWORD clause -- see
# database/init-roles.example.sql for the manual, out-of-band step that sets
# real passwords), SECURITY DEFINER functions, and grant privileges, so they
# run as the postgres owner, not app_user. This is the same URL as the api's
# BYPASSRLS_DATABASE_URL. The runner accepts either DATABASE_URL or
# BYPASSRLS_DATABASE_URL.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kamu-llm-gateway
