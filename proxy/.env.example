# LLM proxy satellite — kamu-llm-gateway (ADR 0001).
#
# This is the NEW proxy that verifies the two DB-backed credential shapes
# (top-level opaque `sk_live_…` keys + Ed25519-signed sub-key JWTs) and retires
# the legacy shared SESSION_JWT_SECRET. The legacy kotisivukamu llm-proxy still
# runs in parallel during the cutover (ADR Migration §1).

# Port the satellite listens on. 8301 — the control-plane api is 8300, this
# avoids the clash.
PORT=8301

# SQLite file for per-key spend tracking (budgeted keys only) + the per-request
# usage_log buffer the control-plane poller drains. Created on first use. On
# Fly point at a mounted volume if the buffer must survive a machine restart;
# otherwise a restart loses unpolled rows (the durable copy lives in the
# gateway Postgres, keyed by key_id — ADR 0001 §8).
DB_PATH=llm-proxy.db

# Postgres connect to the gateway DB for key-meta lookups, as admin_role
# (BYPASSRLS): the lookup has no user context, so as app_user RLS would hide
# every llm.keys row. The proxy
# looks up `llm.keys` rows here by `key_hash` (top-level opaque keys) and by
# `id = jti` (derived sub-keys) to read status/lineage/budget/metadata, then
# caches them in-process (KEY_META_CACHE_TTL_SEC). Must be reachable from the
# proxy; in dev this is the same DB the api uses.
GATEWAY_DATABASE_URL=postgres://admin_role:admin_role@localhost:5432/kamu-llm-gateway

# Ed25519 PUBLIC key for verifying derived sub-key JWTs (ADR 0001 §10.4a).
# Base64 of the raw 32-byte public key. MUST be the SAME public key the
# control-plane api signs sub-keys with — copy the value of ED25519_PUBLIC_KEY
# from api/.env (it is the public half of the api's ED25519_PRIVATE_KEY pair).
# The proxy holds ONLY this public key: it can verify sub-key signatures but
# can never mint, even under full VM compromise. Generate with:
#   openssl genpkey -algorithm Ed25519 -out ed25519-priv.pem
#   openssl pkey -in ed25519-priv.pem -pubout -outform DER 2>/dev/null | tail -c 32 | base64
ED25519_PUBLIC_KEY=
# Key id set in the JWT `kid` header by the api on mint. The proxy accepts
# signatures from this kid (rotation: bump the kid + republish the public key;
# accept the previous kid during a grace window). Must match the api's
# ED25519_KEY_ID.
ED25519_KEY_ID=dev-ed25519-1

# Key-metadata cache TTL (seconds) for top-level opaque-key verification on the
# hot path (ADR 0001 §10.4/§10.6). This is the ONLY window in which a
# revocation or org/team suspension takes to propagate to the proxy without a
# DB read per request — a revoked row is cached as "deny" for up to this TTL.
# 10s = the ADR's stated cache window.
KEY_META_CACHE_TTL_SEC=10

# Shared internal secret for the /usage control-plane poll endpoint. This is a
# NEW service-to-service secret (NOT a user credential) — the poller presents
# it as `Authorization: Bearer`. Required: /usage 401s without it. The proxy
# never mints or verifies user credentials for /usage anymore.
CONTROL_PLANE_POLL_TOKEN=

# Upstream provider keys. Only the ones for providers you actually want to
# route to need to be set; others can stay empty. A request to a provider whose
# key is unset gets a 502 (provider_key_missing) — same as the legacy proxy.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
MOONSHOT_API_KEY=
OPENCODE_ZEN_API_KEY=
CORTECS_API_KEY=
TENSORX_API_KEY=

VERSION=dev
