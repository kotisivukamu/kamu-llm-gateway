PORT=8302

# Owner/BYPASSRLS connection, scoped to the llm schema (same physical role as
# api's BYPASSRLS_DATABASE_URL). admin/ reads/writes llm.keys, llm.usage_log,
# llm.settings across ALL orgs -- this is a superuser surface, not RLS-scoped.
ADMIN_DATABASE_URL=postgres://postgres:postgres@localhost:5432/kamu-llm-gateway

# better-auth's own connection (schema-scoped to admin_auth via a
# search_path connection option set in src/lib/auth.ts). Same physical DB as
# ADMIN_DATABASE_URL is fine in dev; the schema keeps them apart.
ADMIN_AUTH_DATABASE_URL=postgres://postgres:postgres@localhost:5432/kamu-llm-gateway

# better-auth session/cookie signing secret. MUST be a real random secret in
# prod (Fly/Doppler) -- a leaked value forges admin sessions.
BETTER_AUTH_SECRET=dev-only-change-me-please-thanks

BASE_URL=http://localhost:8302

LOG_LEVEL=debug
